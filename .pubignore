# This file REPLACES .gitignore when publishing, so the build-artifact
# excludes are repeated here rather than inherited.
.dart_tool/
build/
coverage/
pubspec.lock
.idea/
.claude/
.githooks/
.playwright-mcp/
.superpowers/

# Development-only; useful in the repo, noise in the package.
AGENTS.md
CLAUDE.md
cspell.json
scripts/

# Example platform scaffolding. pub.dev renders the example from its Dart
# sources, so the platform shells are dead weight.
example/android/
example/ios/
example/macos/
example/linux/
example/windows/
example/web/
example/.dart_tool/
example/build/
example/pubspec.lock
example/.metadata
example/assets/
example/flutter_launcher_icons.yaml
